{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "noEmit": true, "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts"]
}
