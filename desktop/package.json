{
  "name": "xactions-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "XActions desktop workbench — Electron, Vue 3 and TypeScript",
  "author": "nich (@nichxbt)",
  "license": "Apache-2.0",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "catalog": "node scripts/catalog.mjs",
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run catalog && npm run typecheck && vite build && npm run build:electron",
    "start": "node scripts/start.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.10.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.5.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "41.6.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.0.0"
  }
}
